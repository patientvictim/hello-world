# Copy this file to `.env` and fill in your real key.
#   cp .env.example .env
#
# Get a key from the Runway Developer Portal: https://dev.runwayml.com/
# The official SDKs read the key from this exact variable name.
# Do NOT commit `.env` — it is gitignored.
RUNWAYML_API_SECRET=your_runway_api_key_here
